// Nøde on Cloudflare Workers. Deploy: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "node",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  // Global users run on US servers (Ashburn, Virginia); Russia is served by the ru.* copies on Yandex Cloud.
  "placement": { "region": "gcp:us-east4" },
  "workers_dev": false,
  "routes": [{ "pattern": "node.infinitumcorporation.ai", "custom_domain": true }],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "node", "database_id": "3fd737cd-cd58-4014-b0c8-9a5f75103094" }],
  "vars": {
    // Where browsers go to sign in on the main site.
    "CID_PUBLIC_ISSUER": "https://id.cumuluscloud.app",
    // Where they go when they arrive through the Russian mirror (mirror/), which marks its requests.
    "CID_MIRROR_ISSUER": "https://ru.id.cumuluscloud.app"
  },
  // Anonymous telemetry: 20 a minute per address, 300 a minute per hotspot (namespace ids are per account).
  "ratelimits": [
    { "name": "TELEMETRY_IP", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
    { "name": "TELEMETRY_HOTSPOT", "namespace_id": "4102", "simple": { "limit": 300, "period": 60 } },
    // Paired routers: 10 calls a minute each (nod-sync makes 2 every 5 minutes).
    { "name": "ROUTER_LIMIT", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
