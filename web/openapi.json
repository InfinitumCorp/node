{
  "openapi": "3.1.0",
  "info": {
    "title": "Nøde API",
    "version": "1",
    "description": "Free community Wi-Fi. People sign in with Cumulus ID; routers use their own pairing key; data buyers use a license key. Analytics never carry an account id, and reports drop groups under 10 sessions."
  },
  "servers": [
    {
      "url": "https://node.infinitumcorporation.ai"
    },
    {
      "url": "https://node-ru.infinitumcorporation.ai",
      "description": "Russian mirror (no VPN needed)"
    }
  ],
  "components": {
    "securitySchemes": {
      "cumulusId": {
        "type": "http",
        "scheme": "bearer",
        "description": "Cumulus ID access token (client `node`)."
      },
      "routerKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "`nr_...` key from Host > Pair a router. Header only, never in a URL."
      },
      "buyerKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-node-buyer-key",
        "description": "Data license key."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Limits": {
        "type": "object",
        "properties": {
          "maxMbps": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          },
          "dailyMb": {
            "type": "number",
            "minimum": 50
          },
          "minBatteryPct": {
            "type": "number",
            "minimum": 20,
            "maximum": 100
          },
          "maxTempC": {
            "type": "number",
            "minimum": 30,
            "maximum": 60
          },
          "hours": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "maxItems": 24,
            "description": "Empty: any time."
          }
        }
      },
      "Hotspot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "home",
              "business",
              "relay",
              "gateway",
              "phone"
            ]
          },
          "ssid": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        }
      },
      "Router": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "hotspot": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "integer"
          },
          "lastSeen": {
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "tempC": {
            "type": [
              "integer",
              "null"
            ]
          },
          "usedMb": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Public settings for the web app (sign-in issuer; the Russian mirror gets ru.id)",
        "responses": {
          "200": {
            "description": "Config",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cidIssuer": {
                      "type": "string"
                    },
                    "cidClient": {
                      "type": "string"
                    },
                    "policy": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/purposes": {
      "get": {
        "summary": "What each data purpose means",
        "responses": {
          "200": {
            "description": "Purposes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/jurisdictions": {
      "get": {
        "summary": "Consent defaults by jurisdiction",
        "responses": {
          "200": {
            "description": "Jurisdictions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/hotspots": {
      "get": {
        "summary": "Active hotspots around a point (public)",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Nearest first, with distanceKm",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/telemetry": {
      "post": {
        "summary": "Anonymous visit or network-quality sample (only with the matching consent)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "kind",
                  "hotspot",
                  "session"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "quality",
                      "visit"
                    ]
                  },
                  "hotspot": {
                    "type": "string"
                  },
                  "session": {
                    "type": "string",
                    "description": "Random, rotates daily, never linked to an account"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "downMbps": {
                    "type": "number"
                  },
                  "upMbps": {
                    "type": "number"
                  },
                  "latencyMs": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Account and consent state",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Me",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Erase account, consent ledger, hotspots and routers",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Erased",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/consent": {
      "put": {
        "summary": "Change data choices",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "jurisdiction": {
                    "type": "string"
                  },
                  "choices": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/hotspots": {
      "get": {
        "summary": "My hotspots",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "responses": {
          "200": {
            "description": "Hotspots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register a hotspot (needs the host_bandwidth choice; starts stopped)",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "lat",
                  "lng"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "kind": {
                    "enum": [
                      "home",
                      "business",
                      "relay",
                      "gateway",
                      "phone"
                    ]
                  },
                  "ssid": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lng": {
                    "type": "number"
                  },
                  "limits": {
                    "$ref": "#/components/schemas/Limits"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hotspot": {
                      "$ref": "#/components/schemas/Hotspot"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/hotspots/{id}": {
      "patch": {
        "summary": "Rename, start/stop, change limits",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^hs_[A-Za-z0-9_-]{6,20}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "active": {
                    "type": "boolean"
                  },
                  "limits": {
                    "$ref": "#/components/schemas/Limits"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/hotspots/{id}/activity": {
      "get": {
        "summary": "The venue's own busy-hours report (hours under 10 sessions hidden)",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^hs_[A-Za-z0-9_-]{6,20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/hotspots/{id}/routers": {
      "get": {
        "summary": "Paired routers and what they last reported",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^hs_[A-Za-z0-9_-]{6,20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Routers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "routers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Router"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Pair a router. The key is returned once and stored only as a hash. Up to 10 per hotspot.",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^hs_[A-Za-z0-9_-]{6,20}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 40
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Paired",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "router": {
                      "$ref": "#/components/schemas/Router"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/hotspots/{id}/routers/{rid}": {
      "delete": {
        "summary": "Unpair; the key stops working at once",
        "security": [
          {
            "cumulusId": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^hs_[A-Za-z0-9_-]{6,20}$"
            }
          },
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^rt_[A-Za-z0-9_-]{6,20}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/router/config": {
      "get": {
        "summary": "The hotspot's switch, network name and limits, for nod-sync",
        "security": [
          {
            "routerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Config",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hotspot": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "ssid": {
                      "type": "string"
                    },
                    "active": {
                      "type": "boolean"
                    },
                    "limits": {
                      "type": "object",
                      "properties": {
                        "maxMbps": {
                          "type": "integer"
                        },
                        "dailyMb": {
                          "type": "integer"
                        },
                        "hours": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          }
                        },
                        "maxTempC": {
                          "type": "number"
                        }
                      }
                    },
                    "poll": {
                      "type": "integer",
                      "description": "Seconds between checks"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/router/status": {
      "post": {
        "summary": "What the router decided, its hottest sensor and guest MB today (host totals only, nothing about guests)",
        "security": [
          {
            "routerKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "tempC": {
                    "type": "number"
                  },
                  "usedMb": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Recorded"
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/connectivity": {
      "get": {
        "summary": "Aggregated network quality for an area (licensed)",
        "security": [
          {
            "buyerKey": []
          }
        ],
        "parameters": [
          {
            "name": "area",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 5
            },
            "description": "Geohash"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Default: 7 days before `to`."
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Default: now."
          }
        ],
        "responses": {
          "200": {
            "description": "Report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
